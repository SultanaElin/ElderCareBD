# Copy to a local .env or configure these in the shell/service manager.
# Never commit real values.
ELDERCARE_DATABASE_URL=sqlite:///./eldercare_bd.db
ELDERCARE_ENVIRONMENT=development
ELDERCARE_OTP_DELIVERY_MODE=capture
ELDERCARE_OTP_HMAC_SECRET=replace-with-at-least-32-random-characters

# SMTP mode (production):
ELDERCARE_SMTP_HOST=
ELDERCARE_SMTP_PORT=587
ELDERCARE_SMTP_FROM=
ELDERCARE_SMTP_USERNAME=
ELDERCARE_SMTP_PASSWORD=
ELDERCARE_SMTP_STARTTLS=true
ELDERCARE_SMTP_SSL=false
ELDERCARE_SMTP_TIMEOUT_SECONDS=10

# OCR:
ELDERCARE_TESSERACT_CMD=
ELDERCARE_TESSERACT_LANGUAGES=eng
ELDERCARE_TESSERACT_TIMEOUT_SECONDS=20
ELDERCARE_OCR_MAX_CONCURRENCY=2
ELDERCARE_PRIVATE_UPLOAD_DIR=

# Flutter receives this at build/run time, not from this backend environment file:
# --dart-define=ELDERCARE_API_BASE_URL=https://api.example.com

