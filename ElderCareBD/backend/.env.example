# Reference only: the backend does not automatically load this file.
# Production must use ELDERCARE_ENVIRONMENT=production with configured SMTP.

# Local/physical-device demo values:
ELDERCARE_ENVIRONMENT=development
ELDERCARE_OTP_DELIVERY_MODE=capture
# Leave ELDERCARE_OTP_HMAC_SECRET unset when using run_local_demo.py so it can
# generate an ephemeral process-only value, or supply a real random 32+ character
# secret through the shell environment. Never copy a placeholder into production.

# Gmail production email OTP reference (keep real values outside source control):
# ELDERCARE_ENVIRONMENT=production
# ELDERCARE_OTP_DELIVERY_MODE=smtp
# ELDERCARE_OTP_HMAC_SECRET=<random-secret-with-at-least-32-characters>
# ELDERCARE_SMTP_HOST=smtp.gmail.com
# ELDERCARE_SMTP_PORT=587
# ELDERCARE_SMTP_FROM=<your-gmail-address>
# ELDERCARE_SMTP_USERNAME=<your-gmail-address>
# ELDERCARE_SMTP_PASSWORD=<google-16-digit-app-password>
# ELDERCARE_SMTP_STARTTLS=true
# ELDERCARE_SMTP_SSL=false
# ELDERCARE_SMTP_TIMEOUT_SECONDS=10
